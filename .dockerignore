# Ignore Python cache and compiled files
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc

# Virtual environments
env/
venv/
.venv/

# Pipenv and build artifacts
.pip-wheel-metadata/
build/
dist/
*.egg-info/
*.egg

# Test/cache
.pytest_cache/
.coverage

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Environment files
.env
.env.*

# Node
node_modules/

# Git
.git

# Ignore local Docker compose override files
docker-compose.override.yml

# Keep Pipfile and Pipfile.lock so Docker can build from them
!Pipfile
!Pipfile.lock

# Buildx cache (local)
.buildx-cache/

# Common caches
.cache/

# Source JS modules (bundled in bundle.min.js)
llm_memedescriber/static/core.js
llm_memedescriber/static/api.js
llm_memedescriber/static/auth-search.js
llm_memedescriber/static/memes-ui.js
llm_memedescriber/static/meme-actions.js
llm_memedescriber/static/deduplication.js
llm_memedescriber/static/sync-download.js
llm_memedescriber/static/index.js

# Development bundle (use minified version)
llm_memedescriber/static/bundle.js
llm_memedescriber/static/bundle.js.map
llm_memedescriber/static/bundle.js.gz# Local npm artifacts (if any)
package-lock.json
node_modules/
